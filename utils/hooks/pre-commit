#!/bin/bash

echo "🔧 Rewriting image paths in staged Markdown files..."

# Get list of staged .md files (new or modified)
files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$')

for file in $files; do
  if [ -f "$file" ]; then
    echo "  🔍 Checking $file"
    tmpfile=$(mktemp)

    # Rewrite relative Markdown image paths to root-relative
    sed -E 's|!\[\]\(assets/images/([^)]+)\)|![](/assets/images/\1)|g' "$file" > "$tmpfile"

    # If changes occurred, update file and restage it
    if ! cmp -s "$file" "$tmpfile"; then
      echo "  ✅ Fixed: $file"
      mv "$tmpfile" "$file"
      git add "$file"
    else
      echo "  ⏩ No changes needed for $file"
      rm "$tmpfile"
    fi
  fi
done

echo "✅ Image path rewrite complete."

echo -e "\nRunning image resize script...\n"

# Get repo root reliably even if git runs hook from elsewhere
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Run your python util (pick python3 explicitly)
RESIZE_THUMBNAIL_SCRIPT="$REPO_ROOT/utils/resize_thumbnails.py"

echo
echo "[pre-commit] running $RESIZE_THUMBNAIL_SCRIPT ..."
echo
python3 "$RESIZE_THUMBNAIL_SCRIPT"


# Run your python util (pick python3 explicitly)
CREATE_POSTS_JSON_SCRIPT="$REPO_ROOT/utils/create_posts_json_for_3d.py"

echo
echo "[pre-commit] running $CREATE_POSTS_JSON_SCRIPT ..."
echo
python3 "$CREATE_POSTS_JSON_SCRIPT"